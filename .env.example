# Copy this file to .env and provide credentials through your local secret manager.
PRAHARI_ENV=development
DATABASE_URL=
POSTGRES_DB=prahari
POSTGRES_USER=prahari
POSTGRES_PASSWORD=change-me
PRAHARI_DATA_DIR=./data
PRAHARI_APPROVER_TOKEN=
PRAHARI_SLO_WINDOW_SECONDS=300
PRAHARI_AUDIT_RETENTION_DAYS=180
ALERT_SUPPRESSION_SECONDS=300

# AI investigation
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-7-sonnet-latest

# Authentication (Auth0 JWT validation)
AUTH_PROVIDER=none
AUTH_ISSUER_URL=
AUTH_AUDIENCE=

# Error reporting and tracing
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
OTEL_EXPORTER_OTLP_ENDPOINT=
LOKI_URL=
LOKI_TENANT_ID=
LOKI_BEARER_TOKEN=
DATADOG_API_KEY=
DATADOG_APP_KEY=
DATADOG_SITE=datadoghq.com

# Source control and deployment events
GITHUB_REPOSITORY=
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITLAB_WEBHOOK_SECRET=
DEPLOYMENT_PROVIDER=
RENDER_API_KEY=
RENDER_STAGING_SERVICE_ID=
RENDER_PRODUCTION_SERVICE_ID=
KOYEB_API_TOKEN=
KOYEB_STAGING_SERVICE_ID=
KOYEB_PRODUCTION_SERVICE_ID=
STAGING_BASE_URL=
PRODUCTION_BASE_URL=

# Notifications
PAGERDUTY_ROUTING_KEY=
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PRAHARI_SEND_NOTIFICATIONS=false

# Detector
DETECTOR_AUTOSTART=true
DETECTOR_POLL_INTERVAL=10
